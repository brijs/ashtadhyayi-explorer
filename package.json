{
	"name": "ashtadhyayi-explorer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"data": "bash scripts/fetch-data.sh && node scripts/build-data.ts",
		"data:build": "node scripts/build-data.ts",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:smoke": "node tests/smoke.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.20.5",
		"playwright-core": "^1.63.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"@fontsource/noto-serif-devanagari": "^5.3.0",
		"minisearch": "^7.2.0"
	}
}
